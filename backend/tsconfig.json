{
  "compilerOptions": {
    "target": "ES2020",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "sourceMap": false,
    "noEmit": false
  },

  "include": [
    "src/**/*",
    "types/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}